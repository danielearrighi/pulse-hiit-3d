{
  "name": "exercise-planner",
  "version": "1.0.0",
  "description": "Express & PostgreSQL 18 Cardio HIIT Planner with 3D Mannequin Exercise Simulator",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "test": "node server/tests/run-tests.js",
    "postinstall": "npm install --prefix client",
    "db:query": "node scripts/query.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "docker:reset": "docker compose down -v && docker compose up -d"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "i18next": "^26.4.0",
    "i18next-http-middleware": "^3.9.8",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
