# ==============================================================================
# Cardio HIIT Planner - Configurazione Ambiente
# ==============================================================================

# Porta del server Express
PORT=3000

# Chiave segreta per le sessioni utente
SESSION_SECRET=super_secret_session_key_change_me_in_production

# ==============================================================================
# Configurazione Database PostgreSQL 18
# ==============================================================================

# Opzione A: Stringa di Connessione Unificata (DATABASE_URL)
# ------------------------------------------------------------------------------
# Per Docker Locale:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exercise_planner

# Per Render.com (usa la stringa fornita nella dashboard di Render):
# DATABASE_URL=postgresql://user:password@dpg-xxxx.render.com/dbname

# Abilita SSL per connessioni cloud (es. Render.com / Neon / Supabase):
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# Opzione B: Parametri Singoli (usati in alternativa se DATABASE_URL non è impostato)
# ------------------------------------------------------------------------------
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=exercise_planner
